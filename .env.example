# مِداد — نموذج إعدادات محلي
PORT=8787
WHISPER_MODEL=base
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# أنشئ Vercel Blob Store واربطه ببيئة Production لتفعيل الرفع المباشر للفيديوهات الكبيرة.
# يضيف Vercel هذا السر تلقائيًا؛ لا تضعه في Git.
# BLOB_READ_WRITE_TOKEN=
# على Vercel يستخدم التطبيق VERCEL_OIDC_TOKEN تلقائيًا عند توفره.
# للتشغيل خارج Vercel أضف مفتاح AI Gateway هنا محليًا فقط، ولا ترفعه إلى Git.
AI_GATEWAY_MODEL=openai/gpt-4o-mini
# إطارات الفيديو لا تُرسل للبوابة ما لم تُفعّل نموذج الرؤية صراحةً.
# AI_GATEWAY_TIMEOUT_MS=90000
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_VISION_MODEL=openai/gpt-4o-mini
# اختياري: اسم نموذج رؤية يدعم الصور في Ollama
# OLLAMA_VISION_MODEL=qwen3-vl:4b
# REDIS_URL=redis://localhost:6379
